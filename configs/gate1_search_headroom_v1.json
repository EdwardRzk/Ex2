{
  "experiment_name": "gate1_search_headroom_v1",
  "hypothesis": "Without a learned model, fixed-budget phase-ordering search can find pass sequences that reproducibly outperform LLVM -O3 on PolyBench/C.",
  "dataset": {
    "name": "PolyBench/C 4.2.1-beta",
    "role": "gate1_development_validation",
    "archive_url": "https://sourceforge.net/projects/polybench/files/polybench-c-4.2.1-beta.tar.gz/download",
    "archive_sha256": "426519ee8443a5f2175de6a3e9328cda8917a5e33053d0e8f59855ab56d689a4",
    "train_split": null,
    "test_split": null,
    "cbench_accessed": false,
    "kernels": [
      {"name": "2mm", "source": "linear-algebra/kernels/2mm/2mm.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "3mm", "source": "linear-algebra/kernels/3mm/3mm.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "gramschmidt", "source": "linear-algebra/solvers/gramschmidt/gramschmidt.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "lu", "source": "linear-algebra/solvers/lu/lu.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "ludcmp", "source": "linear-algebra/solvers/ludcmp/ludcmp.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "floyd-warshall", "source": "medley/floyd-warshall/floyd-warshall.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "nussinov", "source": "medley/nussinov/nussinov.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "adi", "source": "stencils/adi/adi.c", "dataset_macro": "MEDIUM_DATASET"},
      {"name": "heat-3d", "source": "stencils/heat-3d/heat-3d.c", "dataset_macro": "MEDIUM_DATASET"}
    ]
  },
  "toolchain": {
    "compiler_gym_version": "0.2.5",
    "numpy_version": "1.26.4",
    "llvm_version": "10.0.0",
    "baseline_pipeline": "opt -O3 followed by llc -O3",
    "candidate_pipeline": "ordered named opt passes followed by llc -O3",
    "common_defines": ["POLYBENCH_TIME", "POLYBENCH_NO_FLUSH_CACHE"]
  },
  "search": {
    "action_subset": [
      "-adce", "-simplifycfg", "-constmerge", "-deadargelim", "-dce", "-dse",
      "-early-cse", "-gvn", "-globaldce", "-globalopt", "-indvars", "-instsimplify",
      "-instcombine", "-jump-threading", "-lcssa", "-licm", "-loop-deletion",
      "-loop-rotate", "-loop-simplify", "-loop-unroll", "-loop-unswitch", "-mem2reg",
      "-reassociate", "-sccp"
    ],
    "allow_repeated_passes": true,
    "max_sequence_length": 16,
    "evaluations_per_method_per_kernel": 128,
    "random_sequence_count": 128,
    "greedy_candidates_per_step": 8,
    "seed": 41
  },
  "measurement": {
    "cpu_affinity": 24,
    "minimum_runtime_seconds": 0.02,
    "qualification_warmup_runs": 20,
    "qualification_blocks": 2,
    "qualification_runs_per_block": 10,
    "maximum_cv": 0.01,
    "maximum_relative_mad": 0.005,
    "maximum_block_median_drift": 0.01,
    "search_warmup_runs": 3,
    "search_formal_runs": 10,
    "confirmation_warmup_runs": 10,
    "confirmation_blocks": 2,
    "confirmation_runs_per_block": 10,
    "statistic": "median"
  },
  "metrics": {
    "speedup_definition": "o3_confirmation_median / selected_sequence_confirmation_median",
    "bootstrap_resamples": 10000,
    "bootstrap_confidence": 0.95,
    "classification_threshold": 0.01,
    "stable_kernel_ci_lower_bound": 1.01
  },
  "pass_fail_gate": {
    "measurement_qualification_all_kernels": true,
    "geometric_mean_speedup_strictly_greater_than": 1.0,
    "bootstrap_95_percent_ci_lower_bound_strictly_greater_than": 1.0,
    "minimum_stable_improved_kernel_fraction": 0.25,
    "independent_confirmation_required": true,
    "correctness_failures": 0,
    "equal_search_evaluation_budget_required": true
  }
}
