  },
  "candidate_representation_source": "configs/controlled_nvp_stage_a_v6.json",
  "experiment_name": "policy_aware_mambanvp_v1",
  "final_label_shards": "outputs/route_a_final_objecttext_v6/shards/final",
  "final_seed_set": [
    1,
    2,
    3
  ],
